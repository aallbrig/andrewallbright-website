# Copy to .env (gitignored). Values here are placeholders, never real credentials.
# SSH alias defined in ~/.ssh/config (Host, User, IdentityFile live there, not in this repo)
WP_SSH_HOST=aa-wp
# Absolute path to the WordPress root on the server
WP_PATH=/home/USER/andrewallbright.com
# PHP binary used to run wp-cli (the host default PHP is too old for some plugins)
WP_PHP=/usr/local/php83/bin/php

# Local docker WordPress harness (task wp:up). Throwaway dev values only; `task setup` generates
# them into the gitignored .env. Never reuse production values here.
WP_DEV_PORT=8080
WP_DEV_URL=http://localhost:8080
WP_DEV_DB_NAME=wordpress
WP_DEV_DB_USER=wordpress
WP_DEV_DB_PASSWORD=change-me-dev-only
WP_DEV_DB_ROOT_PASSWORD=change-me-dev-only-root
WP_DEV_ADMIN_USER=admin
WP_DEV_ADMIN_PASSWORD=change-me-dev-only-admin
WP_DEV_ADMIN_EMAIL=admin@example.test
