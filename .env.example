# Copy to .env (gitignored). Values here are placeholders, never real credentials.
# SSH alias defined in ~/.ssh/config (Host, User, IdentityFile live there, not in this repo)
WP_SSH_HOST=aa-wp
# Absolute path to the WordPress root on the server
WP_PATH=/home/USER/andrewallbright.com
# PHP binary used to run wp-cli (the host default PHP is too old for some plugins)
WP_PHP=/usr/local/php83/bin/php
