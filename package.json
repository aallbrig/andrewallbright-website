{
  "name": "andrewallbright-website",
  "private": true,
  "description": "JS tooling for the custom WordPress plugins and themes",
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "node --test 'wp-content/plugins/*/tests/js/*.test.js'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "knip": "6.43.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
